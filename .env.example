# ==============================================================================
# LMS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành '.env' và điều chỉnh các giá trị phù hợp với môi trường của bạn.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8.0)
# ------------------------------------------------------------------------------
# Tên cơ sở dữ liệu MySQL
DB_NAME=lms_db

# Tài khoản quản trị cơ sở dữ liệu
DB_USERNAME=root

# Mật khẩu kết nối CSDL (thay đổi khi deploy production)
DB_PASSWORD=your_database_password_here

# Cổng MySQL expose ra máy host khi chạy Docker (mặc định: 3307 để tránh trùng cổng 3306 local)
DB_PORT=3307

# Host kết nối CSDL (dùng 'localhost' khi chạy local Spring Boot, dùng 'mysql' khi chạy Docker)
DB_HOST=localhost

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Spring Boot)
# ------------------------------------------------------------------------------
# Cổng dịch vụ Backend API
BACKEND_PORT=8080

# Khóa bí mật ký JWT Token (yêu cầu chuỗi Hex 256-bit tối thiểu 64 ký tự)
JWT_SECRET=your_jwt_secret_key_minimum_64_characters_here_change_in_prod

# Thời gian hết hạn của JWT Token tính bằng mili-giây (86400000 ms = 24 giờ)
JWT_EXPIRATION=86400000

# Danh sách các domain Frontend được phép gọi API (phân tách bởi dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Địa chỉ Frontend dùng để in mã tra cứu trong file chứng chỉ tải về
FRONTEND_BASE_URL=http://localhost:5173

# Thư mục lưu trữ file tải lên cục bộ (/app/uploads trong container hoặc uploads khi chạy local)
UPLOAD_DIR=/app/uploads

# Tỷ lệ hoa hồng nền tảng (0.20 = 20%)
PLATFORM_COMMISSION_RATE=0.20

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION (ReactJS / Vite)
# ------------------------------------------------------------------------------
# Cổng ứng dụng Frontend khi chạy bằng Docker Container Nginx
FRONTEND_PORT=3000

# Địa chỉ Backend API cho Frontend gọi đến (Vite build / dev)
VITE_API_URL=http://localhost:8080

# Host / IP Public (IP LAN, ngrok domain, hoặc IP VPS) để quét mã QR thanh toán hai thiết bị
VITE_PUBLIC_HOST=