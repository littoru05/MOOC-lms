# API Base URL for LMS Backend
VITE_API_URL=http://localhost:8080

# VITE_PUBLIC_HOST: Dùng cho tính năng QR thanh toán 2 thiết bị.
# - Dev qua LAN: điền IP LAN máy bạn (chạy ipconfig/ifconfig để lấy)
# - Dev qua ngrok: điền URL ngrok đầy đủ (https://xxxx.ngrok-free.app)
# - Production: điền domain/IP public của server
VITE_PUBLIC_HOST=
